# Dependencies
node_modules/

# Build outputs
dist/
out/
*.tsbuildinfo

# Bundled artifacts built elsewhere (kernel bundle, staged MCP runtime) — never committed
vendor/

# Caches
.turbo/
.cache/
.vite/

# Test artifacts
.artifacts/
coverage/

# Logs
*.log
logs/

# Local environment
.env
.env.*
!.env.example
*.local

# OS / editor noise
.DS_Store
Thumbs.db

# Python bytecode. `importlib` drops these NEXT TO THE SOURCE when a test
# loads a shipping module by path — inside kernel/, whose own .gitignore is an
# upstream file we do not widen for this.
__pycache__/
*.pyc

# The staged Agent Kernel: bundle, wasm and its two external dependencies, built from
# kernel/ by packages/electron/scripts/prepare-geocode-kernel.mjs. It belongs beside the
# electron package's own upstream .gitignore entries, but that file is upstream's and we
# do not widen it — same rule as the bytecode entry above.
desktop/packages/electron/resources/kernel/
