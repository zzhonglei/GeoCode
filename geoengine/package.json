{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@geocode/geoengine",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun ./script/build.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p script/tsconfig.json"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "effect": "4.0.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "prettier": "3.6.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
